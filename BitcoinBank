const GENERATE_HISTORICAL_CHART = (basePrice, timeframe) => {
  const points = timeframe === '24h' ? 24 : timeframe === '7d' ? 28 : 30;
  const data = [];
  let current = basePrice * (timeframe === '24h' ? 0.96 : timeframe === '7d' ? 0.90 : 0.82);
  
  for (let i = 0; i < points; i++) {
    const randomVariation = (Math.random() - 0.47) * (basePrice * 0.02);
    current = Math.max(current + randomVariation, basePrice * 0.5);
    data.push({
      time: timeframe === '24h' ? `${i}:00` : timeframe === '7d' ? `Day ${Math.floor(i/4) + 1}` : `Day ${i + 1}`,
      price: parseFloat(current.toFixed(current < 2 ? 4 : 2))
    });
  }
  data[data.length - 1].price = basePrice;
  return data;
};

