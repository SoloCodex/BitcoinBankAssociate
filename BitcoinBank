                  <div>
                    <span className="text-[10px] font-bold text-amber-400 uppercase tracking-wider bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
                      TIME DEPOSIT ACCOUNT
                    </span>
                    <h2 className="text-2xl font-black text-white mt-1">My Account</h2>
                    <p className="text-xs text-slate-400">Created: November 10, 2024</p>
                  </div>
                  <span className="self-start sm:self-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5">
                    <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    ACTIVE
                  </span>
                </div>

                <div>
                  <p className="text-xs text-slate-400 uppercase tracking-wider font-semibold">Account Balance</p>
                  <p className="text-3xl sm:text-4xl font-black text-white font-mono mt-1">
                    {formatMoney(myTotalPHP)}
                  </p>
                </div>

                <div className="bg-amber-500/10 border border-amber-500/30 rounded-xl p-3.5 flex items-center space-x-3 text-amber-300 text-xs font-medium">
                  <Lock className="w-5 h-5 text-amber-400 shrink-0" />
                  <span>Time Deposit Account to be withdrawn on exactly June 30, 2030.</span>
                </div>
              </div>

              {/* Deposit History */}
              <div className="bg-[#121824] rounded-2xl border border-slate-800 p-6 space-y-4">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <h3 className="text-base font-bold text-white uppercase tracking-wider">
                    Deposit Transaction History
                  </h3>
                  <span className="text-xs text-slate-400">Sorted Descending Chronological Order</span>
                </div>

                <div className="overflow-x-auto">
                  <table className="w-full text-left text-xs">
                    <thead>
                      <tr className="border-b border-slate-800 text-slate-400 uppercase text-[10px] tracking-wider">
                        <th className="py-3 px-3">Date</th>
                        <th className="py-3 px-3">Reference No.</th>
                        <th className="py-3 px-3">Description</th>
                        <th className="py-3 px-3">Status</th>
                        <th className="py-3 px-3 text-right">Amount</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-800/50 font-mono">
                      {myTxns.map((txn) => (
                        <tr key={txn.id} className="hover:bg-slate-800/30 transition-colors">
                          <td className="py-3 px-3 whitespace-nowrap text-slate-300">
                            {txn.date}
                            <span className="block text-[10px] text-slate-500 font-sans">{txn.monthYear}</span>
                          </td>
                          <td className="py-3 px-3 whitespace-nowrap">
                            <button
                              onClick={() => handleCopyRef(txn.id)}
                              className="text-amber-400 hover:underline flex items-center gap-1 font-mono text-[11px]"
                              title="Click to copy reference"
                            >
                              {txn.id}
                              {copiedRef === txn.id ? <Check className="w-3 h-3 text-emerald-400" /> : <Copy className="w-3 h-3 opacity-60" />}
                            </button>
                          </td>
                          <td className="py-3 px-3 font-sans text-slate-200">{txn.description}</td>
                          <td className="py-3 px-3 whitespace-nowrap">
                            <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                              {txn.status}
                            </span>
                          </td>
                          <td className="py-3 px-3 text-right font-bold text-emerald-400 font-mono whitespace-nowrap">
                            +{formatMoney(txn.amount)}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                {/* Summary Card at Bottom */}
                <div className="bg-[#0A0E17] p-4 rounded-xl border border-slate-800 flex justify-between items-center text-xs sm:text-sm font-bold">
                  <span className="text-slate-300">TOTAL DEPOSITED PRINCIPAL:</span>
                  <span className="text-amber-400 font-mono text-base">{formatMoney(myTotalPHP)}</span>
                </div>
              </div>
            </div>
          )}

          {/* ==================== VIEW 6: ACCOUNT HISTORY & SEARCH ==================== */}
          {activeTab === 'transactions' && (
            <div className="space-y-6">
              <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                  <h2 className="text-xl font-bold text-white">Global Account History</h2>
                  <p className="text-xs text-slate-400">Searchable consolidated transaction logs for all time deposit accounts</p>
                </div>

                {/* Search Bar */}
                <div className="relative w-full sm:w-72">
                  <Search className="w-4 h-4 text-slate-400 absolute left-3 top-2.5" />
                  <input
                    type="text"
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    placeholder="Search ref, date, or amount..."
                    className="w-full bg-[#121824] border border-slate-700/80 rounded-xl pl-9 pr-4 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors"
                  />
                </div>
              </div>

              <div className="bg-[#121824] rounded-2xl border border-slate-800 p-6">
                <div className="overflow-x-auto">
                  <table className="w-full text-left text-xs">
                    <thead>
                      <tr className="border-b border-slate-800 text-slate-400 uppercase text-[10px] tracking-wider">
                        <th className="py-3 px-3">Account</th>
                        <th className="py-3 px-3">Date</th>
                        <th className="py-3 px-3">Reference No.</th>
                        <th className="py-3 px-3">Description</th>
                        <th className="py-3 px-3 text-right">Amount</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-800/50 font-mono">
                      {combinedTxns.length > 0 ? (
                        combinedTxns.map((txn) => (
                          <tr key={txn.id} className="hover:bg-slate-800/30 transition-colors">
                            <td className="py-3 px-3 font-sans font-semibold text-amber-400">{txn.account}</td>
                            <td className="py-3 px-3 text-slate-300 font-sans">{txn.date}</td>
                            <td className="py-3 px-3 text-slate-400 font-mono text-[11px]">{txn.id}</td>
                            <td className="py-3 px-3 font-sans text-slate-200">{txn.description}</td>
                            <td className="py-3 px-3 text-right font-bold text-emerald-400 font-mono">
                              +{formatMoney(txn.amount)}
                            </td>
                          </tr>
                        ))
                      ) : (
                        <tr>
                          <td colSpan="5" className="py-8 text-center text-slate-500 text-xs">
                            No transactions found matching "{searchQuery}"
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          )}

          {/* ==================== VIEW 7: HELP CENTER / FAQ & LOCK-IN POLICY ==================== */}
          {activeTab === 'faq' && (
            <div className="space-y-6 max-w-4xl mx-auto">
              <div>
                <h2 className="text-2xl font-black text-white">HELP CENTER & LOCK-IN POLICY</h2>
                <p className="text-xs text-slate-400 mt-1">Frequently asked questions and verified lock-in rules for Time Deposit accounts</p>
              </div>

              {/* ACCOUNT LOCK-IN POLICY BOX */}
              <div className="bg-[#121824] rounded-2xl border border-amber-500/40 p-6 space-y-4 shadow-lg">
                <div className="flex items-center space-x-3 border-b border-slate-800 pb-3">
                  <Shield className="w-5 h-5 text-amber-400" />
                  <h3 className="text-lg font-bold text-white">ACCOUNT LOCK-IN POLICY</h3>
                </div>

                <ol className="list-decimal list-inside space-y-2 text-xs text-slate-300 leading-relaxed font-sans">
                  <li>Funds deposited into a time deposit account cannot be withdrawn before the maturity date.</li>
                  <li>The scheduled withdrawal date is exactly <strong>June 30, 2030</strong>.</li>
                  <li>Early withdrawal is disabled in the account interface.</li>
                  <li>Users cannot manually change the maturity date.</li>
                  <li>The account balance and deposit history cannot be edited by ordinary users.</li>
                  <li>Account information must be protected through secure authentication.</li>
                  <li>Withdrawals on the maturity date must follow the actual account provider's verified terms and withdrawal process.</li>
                  <li>Any applicable interest, penalties, taxes, or fees must be disclosed according to the actual product agreement.</li>
                </ol>

                <div className="bg-amber-500/10 border-l-4 border-amber-500 p-4 rounded-r-xl text-xs text-amber-200 italic">
                  "IMPORTANT NOTICE: Your time deposit is subject to its agreed lock-in period. Early withdrawal is unavailable under the configured account terms. Please review the applicable account agreement for maturity and withdrawal conditions."
                </div>
              </div>

              {/* FAQ EXPANDABLE ACCORDION */}
              <div className="bg-[#121824] rounded-2xl border border-slate-800 p-6 space-y-3">
                <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
                  <HelpCircle className="w-5 h-5 text-amber-400" />
                  Frequently Asked Questions
                </h3>

                <div className="space-y-2">
                  {FAQS.map((faq, idx) => {
                    const isOpen = expandedFaq === idx;
                    return (
                      <div 
                        key={idx}
                        className="border border-slate-800 rounded-xl overflow-hidden bg-[#0A0E17]/40 transition-colors"
                      >
                        <button
                          onClick={() => setExpandedFaq(isOpen ? null : idx)}
                          className="w-full text-left p-4 flex justify-between items-center text-xs sm:text-sm font-semibold text-slate-200 hover:text-amber-400 transition-colors"
                        >
                          <span>{faq.q}</span>
                          <ChevronDown className={`w-4 h-4 transition-transform ${isOpen ? 'rotate-180 text-amber-400' : 'text-slate-500'}`} />
                        </button>
                        {isOpen && (
                          <div className="p-4 pt-0 text-xs text-slate-400 leading-relaxed border-t border-slate-800/60 bg-[#121824]/50">
                            {faq.a}
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          )}

          {/* ==================== VIEW 8: SETTINGS ==================== */}
          {activeTab === 'settings' && (
            <div className="space-y-6 max-w-3xl">
              <div>
                <h2 className="text-xl font-bold text-white">Platform Settings</h2>
                <p className="text-xs text-slate-400">Manage account security, preferences, and display units</p>
              </div>

              <div className="bg-[#121824] rounded-2xl border border-slate-800 p-6 space-y-6">
                <div>
                  <h3 className="text-sm font-bold text-white mb-3">Currency Display</h3>
                  <div className="flex items-center space-x-4 text-xs">
                    <label className="flex items-center space-x-2 cursor-pointer">
                      <input 
                        type="radio" 
                        name="currencyPref" 
                        checked={currency === 'PHP'} 
                        onChange={() => setCurrency('PHP')}
                        className="text-amber-500 focus:ring-amber-500"
                      />
                      <span className="text-slate-200">Philippine Peso (₱ PHP)</span>
                    </label>
                    <label className="flex items-center space-x-2 cursor-pointer">
                      <input 
                        type="radio" 
                        name="currencyPref" 
                        checked={currency === 'USD'} 
                        onChange={() => setCurrency('USD')}
                        className="text-amber-500 focus:ring-amber-500"
                      />
                      <span className="text-slate-200">US Dollar ($ USD)</span>
                    </label>
                  </div>
                </div>

                <div className="border-t border-slate-800 pt-4">
                  <h3 className="text-sm font-bold text-white mb-3">Privacy & Security</h3>
                  <div className="space-y-3">
                    <div className="flex items-center justify-between text-xs text-slate-300">
                      <span>Hide account balances by default</span>
                      <input 
                        type="checkbox" 
                        checked={hideBalances} 
                        onChange={(e) => setHideBalances(e.target.checked)}
                        className="rounded text-amber-500 focus:ring-amber-500" 
                      />
                    </div>
                  </div>
                </div>

                <div className="border-t border-slate-800 pt-4">
                  <button 
                    onClick={() => {
                      if (window.confirm("Reset locally simulated transactions to default?")) {
                        localStorage.removeItem('btc_bank_mama_txns');
                        localStorage.removeItem('btc_bank_my_txns');
                        setMamaTxns(INITIAL_MAMA_TRANSACTIONS);
                        setMyTxns(INITIAL_MY_TRANSACTIONS);
                      }
                    }}
                    className="px-4 py-2 bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-semibold rounded-xl hover:bg-rose-500/20 transition-colors"
                  >
                    Reset Simulated Local Audit Data
                  </button>
                </div>
              </div>
            </div>
          )}

        </main>
      </div>

      {/* MOBILE BOTTOM NAVIGATION BAR */}
      <div className="md:hidden fixed bottom-0 left-0 right-0 bg-[#121824]/95 backdrop-blur-lg border-t border-slate-800/90 z-50 px-2 py-2 flex justify-around items-center">
        <button
          onClick={() => setActiveTab('home')}
          className={`flex flex-col items-center p-1.5 ${activeTab === 'home' ? 'text-amber-400' : 'text-slate-500'}`}
        >
          <Home className="w-5 h-5" />
          <span className="text-[10px] mt-0.5">Home</span>
        </button>

        <button
          onClick={() => setActiveTab('market')}
          className={`flex flex-col items-center p-1.5 ${activeTab === 'market' ? 'text-amber-400' : 'text-slate-500'}`}
        >
          <Activity className="w-5 h-5" />
          <span className="text-[10px] mt-0.5">Market</span>
        </button>

        <button
          onClick={() => setActiveTab('time-deposit')}
          className={`flex flex-col items-center p-1.5 ${['time-deposit', 'mama-detail', 'my-detail'].includes(activeTab) ? 'text-amber-400' : 'text-slate-500'}`}
        >
          <LockKeyhole className="w-5 h-5" />
          <span className="text-[10px] mt-0.5">Vaults</span>
        </button>

        <button
          onClick={() => setActiveTab('transactions')}
          className={`flex flex-col items-center p-1.5 ${activeTab === 'transactions' ? 'text-amber-400' : 'text-slate-500'}`}
        >
          <FileText className="w-5 h-5" />
          <span className="text-[10px] mt-0.5">History</span>
        </button>

        <button
          onClick={() => setActiveTab('faq')}
          className={`flex flex-col items-center p-1.5 ${activeTab === 'faq' ? 'text-amber-400' : 'text-slate-500'}`}
        >
          <HelpCircle className="w-5 h-5" />
          <span className="text-[10px] mt-0.5">Help</span>
        </button>
      </div>

      {/* SIMULATION DEPOSIT MODAL */}
      {isDepositModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-[#121824] border border-slate-700/80 rounded-2xl w-full max-w-md p-6 space-y-4 shadow-2xl animate-in fade-in zoom-in-95">
            <div className="flex justify-between items-center border-b border-slate-800 pb-3">
              <h3 className="text-base font-bold text-white flex items-center gap-2">
                <PlusCircle className="w-5 h-5 text-amber-400" />
                Simulate Time Deposit Top-Up
              </h3>
              <button 
                onClick={() => setIsDepositModalOpen(false)}
                className="text-slate-400 hover:text-white text-lg font-bold"
              >
                ✕
              </button>
            </div>

            <form onSubmit={handleAddDeposit} className="space-y-4 text-xs">
              <div>
                <label className="block text-slate-300 font-semibold mb-1">Target Vault Account</label>
                <select
                  value={depositAccountTarget}
                  onChange={(e) => setDepositAccountTarget(e.target.value)}
                  className="w-full bg-[#0A0E17] border border-slate-700 rounded-xl p-2.5 text-white focus:outline-none focus:border-amber-500"
                >
                  <option value="mama">Mama Account (Current Total: ₱{mamaTotalPHP.toLocaleString()})</option>
                  <option value="my">My Account (Current Total: ₱{myTotalPHP.toLocaleString()})</option>
                </select>
              </div>

              <div>
                <label className="block text-slate-300 font-semibold mb-1">Deposit Amount (PHP ₱)</label>
                <input
                  type="number"
                  step="0.01"
                  required
                  placeholder="e.g. 5000.00"
                  value={depositAmount}
                  onChange={(e) => setDepositAmount(e.target.value)}
                  className="w-full bg-[#0A0E17] border border-slate-700 rounded-xl p-2.5 text-white font-mono focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-slate-300 font-semibold mb-1">Description / Memo</label>
                <input
                  type="text"
                  placeholder="e.g. Additional Savings Top-Up"
                  value={depositDesc}
                  onChange={(e) => setDepositDesc(e.target.value)}
                  className="w-full bg-[#0A0E17] border border-slate-700 rounded-xl p-2.5 text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div className="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-[11px] text-amber-300">
                Note: This simulation appends a ledger entry directly into local storage audit tables without modifying lock-in dates.
              </div>

              <div className="flex justify-end space-x-2 pt-2">
                <button
                  type="button"
                  onClick={() => setIsDepositModalOpen(false)}
                  className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl font-semibold"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 rounded-xl font-bold hover:from-amber-400 hover:to-yellow-300"
                >
                  Add Entry
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

    </div>
  );
}
